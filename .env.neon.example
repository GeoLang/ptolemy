# Neon connection string — get this from https://console.neon.tech
# Format: postgres://<user>:<password>@<host>/<database>?sslmode=verify-full
# sslmode=require encrypts without checking the certificate, so keep verify-full.
# Neon's certificate chains to a public CA, so no sslrootcert is needed.
NEON_DATABASE_URL=postgres://ptolemy:YOUR_PASSWORD@ep-cool-name-123456.us-east-2.aws.neon.tech/ptolemy?sslmode=verify-full

# JWT secret for Ptolemy API auth
PTOLEMY_JWT_SECRET=replace-with-32-plus-random-bytes

# Days a settled webhook delivery and its event are kept; 0 keeps them forever
PTOLEMY_EVENTS_RETENTION_DAYS=30
